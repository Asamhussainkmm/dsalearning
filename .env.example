# Frontend (public, non-secret values only)
VITE_AI_WORKER_URL=https://dsa-ai-proxy.YOUR-SUBDOMAIN.workers.dev
# Optional: override the Java execution API (default: Judge0 CE public instance)
VITE_JUDGE0_URL=https://ce.judge0.com

# Worker secret is NOT stored here. Set it with:  npx wrangler secret put GROQ_API_KEY
# For local worker dev create worker/.dev.vars (git-ignored) containing:  GROQ_API_KEY=your-key
